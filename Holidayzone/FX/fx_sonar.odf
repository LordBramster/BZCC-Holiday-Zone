//////////////////// CUSTOM FX RENDER //////////////////// 

[Sonar]
renderBase = "draw_multi"
renderCount = 2
renderName1 = "fx_sonar.SonarBlip"
renderName2 = "fx_sonar.SonarRing"

[SonarBlip]
simulateBase = "sim_null"
renderBase = "draw_twirl_trail"
emitDelay = 3.0
emitLife = 0.75 // 1.0
textureName = "lightflare.tga"
textureBlend = "one one modulate"
startColor = "255 0 0 255"
finishColor = "255 0 0 100"
startRadius = 5.0
finishRadius = 0.5
animateTime = 1.0
rotationRate = 10.0
SimulateSoundEffect = "blip02.wav" //blip02

[SonarRing]
simulateBase = "sim_null"
renderBase = "draw_twirl_trail"
emitDelay = 3.0
emitLife = 1.25
textureName = "deflect.tga"
textureBlend = "one one modulate"
startColor = "255 0 0 255"
finishColor = "255 0 0 0"
startRadius = 0.5
finishRadius = 10.0
animateTime = 1.25
rotationRate = 10.0
