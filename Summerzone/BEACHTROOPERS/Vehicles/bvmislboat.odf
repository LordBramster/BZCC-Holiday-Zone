// effectMaxVelocity1 = 500.0

[CraftClass]
// weaponPitch = 0.5

engageRange = 300
rangeScan = 300.0
periodScan = 4.0
velocJam = 0.0

attackTask = "AssaultTankAttack"
subAttackTask = "SupportSubAttack"
subAttackClass = "ANS"
// subAttackClass uses 3 letters.
// 1st letter is either A or N.     A is include Air targets.         N is attack ground only.
// 2nd letter is either D or N.     D is to deploy before attacking.  N for regular attack.
// 3rd letter is either S or N.     S is to use Weapon Range.         N is use the Engage Range to attack. 

braccelFactor = 0.02
strafeFactor = 0.1
velFactor = 0.5
steerFactor = 1.5
omegaFactor = 0.5

selectWaitMsg = "ivmisl04.wav"
selectAttackMsg = "ivmisl01.wav"
selectFollowMsg = "ivmisl03.wav"
selectGoMsg = "ivmisl02.wav"
selectOtherMsg = "ivmisl04.wav"
goMsg = "ivmisl05.wav"
attackMsg = "ivmisl06.wav"
followMeMsg = "ivmisl08.wav"
followMsg = "ivmisl03.wav"
repairMsg = "ivmisl09.wav"
reloadMsg = "ivmisl09.wav"
rescueMsg = "ivmisl10.wav"
recycleMsg = "ivmisl11.wav"
otherMsg = "ivmisl12.wav" 
holdMsg = "ivmisl12.wav"
user1Msg = ""  
killedMsg = "ivmisl07.wav"
diedMsg = ""

[HoverCraftClass]
// ABOVE WATERLINE
// UseWaterHeight = true
// setAltitude = 0.05 // how high off the ground

// UNDER WATERLINE
UseWaterHeight = false
setAltitude = 2.25 // how high off the ground

// WATER FEEL
soundThrust = "jetski.wav"
alphaTrack = 12.0 // springs speed it rights itself 
alphaDamp = 12.0 // shocks
OverWaterVelocFrontMult = 1.0
OverLandVelocFrontMult = 0.15
// DeployedUseWaterHeight = true

velocForward = 25.0 // 15.0
velocReverse = 10.0 // 
velocStrafe = 2.0 // 7.5
accelThrust = 50.0 // acceleration 
accelDragStop = 20.0 // how fast it stops once hands are off controls 
accelJump = 10.0
aiAccelDrag = 10

pitchPitch = 0.0 // nose up 
pitchThrust = 0.025 // nose down 

rollStrafe = 0.1 // rolls while strafing 
omegaSpin = 1.5 // spinning in place speed 
omegaTurn = 1.5 // turning while moving speed 
alphaSteer = 2.0 // how fast it responds to steering 
rollSteer = 0.1 // rolls while steering 

soundTurbo = "avtanke3.wav"

[AssaultHoverClass]
yawRate = 4.0
yawAlpha = 10.0
pitchMin = -0.01 // -0.1
pitchMax = 0.35 // 0.5